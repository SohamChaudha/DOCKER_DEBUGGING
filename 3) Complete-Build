FROM nginx:alpine
RUN adduser -D appuser
USER appuser
WORKDIR /app
COPY . .
HEALTHCHECK --interval=30s --timeout=3s \
CMD curl -f http://localhost/ || exit 1
EXPOSE 8080

2) Compose.yaml file :
services:
 app:
  image: myapp:latest
  restart: unless-stopped
  healthcheck:
    test: ["CMD", "curl", "-f", "http://localhost:3000"]
    interval: 30s
    timeout: 3s
    retries: 3
  ports:
   - "8080:3000"
  deploy:
    resources:
      limits:
        memory: 256M
  environment:
   - APP_ENV=production
  depends_on:
   - db
  env_file: 
    - .env
 db:
  image: postgres
  environment:
   - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
  volumes:
   - dbdata:/var/lib/postgresql/data

volumes:
 dbdata:

3) .env file :
